{
  "name": "pantry-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cf build",
    "cf-typegen": "cf workers types",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && cf deploy --dry-run",
    "db:migrate:local": "cf d1 migrations apply 8bfb84c2-9c88-42f0-84d4-e3987d8d2284 --local --persist-to .cloudflare/state",
    "db:migrate:remote": "cf d1 migrations apply 8bfb84c2-9c88-42f0-84d4-e3987d8d2284",
    "db:seed:local": "cf d1 raw 8bfb84c2-9c88-42f0-84d4-e3987d8d2284 --local --persist-to .cloudflare/state --sql @scripts/seed.sql",
    "db:seed:remote": "cf d1 raw 8bfb84c2-9c88-42f0-84d4-e3987d8d2284 --sql @scripts/seed.sql",
    "dev": "portless run vite",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm cf-typegen && tsc --project tsconfig.json",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "0.3.1",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "@cloudflare/vitest-plugin": "1.6.0",
    "@e2e-dev/web": "0.15.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "cf": "1.0.0-beta.28",
    "e2e": "0.23.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "portless": "0.17.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,json5,css,scss,md,mdx,yml,yaml,html,toml,vue,svelte,astro,graphql}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=24.8.0"
  },
  "packageManager": "pnpm@12.16.1"
}
