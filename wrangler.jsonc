{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pantry-pulse",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DEVICE_ID": "pantry-station-1",
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/mcp", "/mcp/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pantry-pulse",
      "database_id": "8bfb84c2-9c88-42f0-84d4-e3987d8d2284",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "DEVICE_ATTEMPT_RATE_LIMIT",
      "namespace_id": "1001002",
      "simple": {
        "limit": 600,
        "period": 60,
      },
    },
    {
      "name": "DEVICE_RATE_LIMIT",
      "namespace_id": "1001001",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
  "triggers": {
    "crons": ["17 4 * * *"],
  },
}
