{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/vitest-plugin/types"],
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/worker.ts", "src/server/**/*.ts", "test/**/*.ts", ".cloudflare/types"],
  "exclude": ["test/client-motion.test.ts", "test/client-http.test.ts"]
}
